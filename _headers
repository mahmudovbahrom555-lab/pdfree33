# Cloudflare Workers Assets — cache headers
# JS/CSS/fonts: immutable + 1 year (HTML always loads versioned ?v=HASH URLs)
# sw.js: no-cache (browsers cap SW anyway; explicit is safer)
# icons/manifest: shorter TTL (no hash in filename, could update with branding)
# HTML: short TTL with stale-while-revalidate (fast CDN serving with freshness)

# Global security headers applied to every response
# Permissions-Policy: camera=(self) — jpg2pdf's live-camera scan flow
# (js/scanCameraUI.js, getUserMedia) needs camera access on pdfree.io's
# own pages; (self) still blocks any third-party embed of this site
# from ever requesting it. Real production-only bug found via
# Playwright during the 2026-08-22 QA pass: this header can't be set
# via a <meta> tag (unlike CSP), so it never showed up testing against
# a local dist/ server (which sends no such header at all) — worked
# locally, silently failed camera access in production until fixed
# here. microphone/geolocation stay fully disabled — nothing uses them.
/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(self), microphone=(), geolocation=()
  Strict-Transport-Security: max-age=63072000; includeSubDomains; preload

/*.html
  Cache-Control: public, max-age=300, stale-while-revalidate=86400

/sitemap.xml
  Cache-Control: public, max-age=3600
  Content-Type: application/xml; charset=utf-8

/robots.txt
  Cache-Control: public, max-age=86400


/js/vendor/qpdf/lib/qpdf.wasm
  Cache-Control: public, max-age=31536000, immutable
  Content-Type: application/wasm

/js/*
  Cache-Control: public, max-age=31536000, immutable

/css/*
  Cache-Control: public, max-age=31536000, immutable

/fonts/*
  Cache-Control: public, max-age=31536000, immutable

/icons/*
  Cache-Control: public, max-age=604800

/manifest.json
  Cache-Control: public, max-age=3600

/sw.js
  Cache-Control: no-cache
